  # . bin/activate
  if [ -n "${_OLD_JANET_PATH+set}" ]; then
    echo 'An environment is already active, please run `deactivate` first.';
  else
    _OLD_JANET_PATH="$JANET_PATH";
    _OLD_JANET_PATH_SET="${JANET_PATH+set}";
    _OLD_JANET_HISTFILE="$JANET_HISTFILE";
    _OLD_JANET_HISTFILE_SET="${JANET_HISTFILE}";
    _OLD_PATH="$PATH";
    JANET_PATH="/home/cass/dev/contrib/tomlin/venv";
    JANET_VIRTUAL_ENV="venv";
    JANET_HISTFILE="/home/cass/dev/contrib/tomlin/venv/repl_history.jdn";
    PATH="$JANET_PATH"/bin:"$PATH";

    export _OLD_JANET_PATH;
    export _OLD_JANET_HISTFILE;
    export _OLD_PATH;
    export JANET_PATH;
    export JANET_VIRTUAL_ENV;
    export JANET_HISTFILE;
    export PATH;

    if [ -z "${JANET_ENV_DISABLE_PROMPT+set}" ]; then
      _OLD_PS1="$PS1";
      PS1="("venv") ${PS1:-}";
      export _OLD_PS1;
      export PS1;
    fi

    hash -r 2> /dev/null;
    deactivate() {
      PATH="$_OLD_PATH";
      if [ -n "$_OLD_JANET_PATH_SET" ]; then
        JANET_PATH="$_OLD_JANET_PATH";
      else
        unset JANET_PATH;
      fi
      if [ -n "$_OLD_JANET_HISTFILE_SET" ]; then
        JANET_HISTFILE="$_OLD_JANET_HISTFILE";
      else
        unset JANET_HISTFILE;
      fi
      unset JANET_VIRTUAL_ENV;

      export JANET_PATH;
      export JANET_VIRTUAL_ENV;
      export JANET_HISTFILE;
      export PATH;
      unset _OLD_JANET_PATH;
      unset _OLD_JANET_PATH_SET;
      unset _OLD_JANET_HISTFILE;
      unset _OLD_JANET_HISTFILE_SET;
      unset _OLD_PATH;
      unset -f deactivate;

      if [ -n "${_OLD_PS1}" ] ; then
        PS1="$_OLD_PS1";
        export PS1;
        unset _OLD_PS1;
      fi

      hash -r 2> /dev/null;
    }
  fi;
  hash -r 2> /dev/null;
  